<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Bakery.Master.cs" Inherits="BakeryBillingSystem.Bakery" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Sweet Crumbs Bakery Billing System</title>

    <link href="Css/style.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

<form id="form1" runat="server">

    <!-- HEADER -->

    <div class="header">

        <div class="logo-section">

            <div class="logo-circle">
                🥐
            </div>

            <div>

                <h1>Sweet Crumbs Bakery</h1>

                <div class="tagline">
                    Bakery Billing Management System
                </div>

            </div>

        </div>

    </div>

    <!-- NAVIGATION -->

    <div class="menu">

        <a href="Login.aspx">🏠 Login</a>

        <a href="Billing.aspx">🧾 Billing</a>

        <a href="Bill.aspx">🖨 Invoice</a>

            <asp:Button
        ID="btnLogout"
        runat="server"
        Text="🚪 Logout"
        CssClass="logout-btn"
        OnClick="btnLogout_Click" />
        <asp:Label
    ID="lblUser"
    runat="server"
    CssClass="welcome-user">
</asp:Label>
    </div>

    <!-- MAIN CONTENT -->

    <div class="container">

        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>

    </div>

    <!-- FOOTER -->

    <div class="footer">

        <p><strong>Sweet Crumbs Bakery</strong></p>

        <p>Bakery Billing System using ASP.NET Web Forms & SQL Server</p>

        <p>© 2026 All Rights Reserved</p>

    </div>

</form>

</body>
</html>